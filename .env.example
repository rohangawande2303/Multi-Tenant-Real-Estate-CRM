# ==============================================================================
# Social Pulse CRM - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (Deploy to Render Web Service)
# ------------------------------------------------------------------------------
# Direct Neon PostgreSQL connection (DO NOT use pooled '-pooler' connection)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/sp_crm?sslmode=require

# Application Environment ('production' enforces startup checks, 'development' allows local testing)
ENVIRONMENT=production

# Public Demo Protection (Set to 'true' to disable destructive deletion on demo environments)
DEMO_MODE=true

# JWT Secret Key (Must be at least 32 characters in production; generate via: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-32-char-minimum-production-secret-key

# JWT Token Expiration in minutes (Default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (Comma-separated frontend URLs; wildcards '*' forbidden with credentials)
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app

# Frontend Web Application URL
FRONTEND_URL=https://your-frontend-app.vercel.app

# Super-Admin Agency Whitelist (Comma-separated emails allowed to access /agency/* and /tenants/*)
# In production, this MUST NOT be empty or startup will fail.
AGENCY_EMAILS=demo_admin@socialpulse.agency

# Default password for seeded demo accounts (Used by scripts/seed_demo.py)
DEMO_PASSWORD=DemoPass2026!

# Login Lockout Limits
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Inbound Webhooks Shared Secret (Optional HMAC fallback verification token)
WEBHOOK_SECRET=replace-with-webhook-secret-token

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Deploy to Vercel)
# ------------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1

# Quick Demo Credentials box on login page ('true' for public portfolio demo, 'false' for production client)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
